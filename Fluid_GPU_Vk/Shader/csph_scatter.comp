#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer ParticlePos { vec4 positions[]; };
layout(set = 0, binding = 3, std430) buffer CellCount   { int  cellCount[]; };
layout(set = 0, binding = 4, std430) buffer CellStart   { int  cellStart[]; };
layout(set = 0, binding = 5, std430) buffer SortedIdx   { int  sortedIdx[]; };

layout(push_constant) uniform PC {
    uint  numParticles;
    float cellSize;
    int   gDimX;
    int   gDimY;
    int   gDimZ;
    float gOrigX;
    float gOrigY;
    float gOrigZ;
} pc;

int getCellIndex(vec3 pos)
{
    ivec3 dim  = ivec3(pc.gDimX, pc.gDimY, pc.gDimZ);
    vec3  orig = vec3(pc.gOrigX, pc.gOrigY, pc.gOrigZ);
    ivec3 cell = ivec3(floor((pos - orig) / pc.cellSize));
    cell = clamp(cell, ivec3(0), dim - ivec3(1));
    return cell.x + cell.y * dim.x + cell.z * dim.x * dim.y;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) return;
    int cellIdx = getCellIndex(positions[i].xyz);
    int offset  = atomicAdd(cellCount[cellIdx], 1);
    sortedIdx[cellStart[cellIdx] + offset] = int(i);
}
