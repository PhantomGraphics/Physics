#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer ParticlePos { vec4 positions[];  };
layout(set = 0, binding = 1, std430) buffer ParticleVel { vec4 velocities[]; };
layout(set = 0, binding = 3, std430) buffer CellCount   { int  cellCount[];  };
layout(set = 0, binding = 4, std430) buffer CellStart   { int  cellStart[];  };
layout(set = 0, binding = 5, std430) buffer SortedIdx   { int  sortedIdx[];  };
layout(set = 0, binding = 6, std430) readonly buffer KernelLut { vec4 kernelLut[]; };

layout(push_constant) uniform PC {
    uint  numParticles;
    float effectLength;
    float cellSize;
    int   gDimX;
    int   gDimY;
    int   gDimZ;
    float gOrigX;
    float gOrigY;
    float gOrigZ;
} pc;

const float PI = 3.14159265358979323846;
const float LUT_LAST = 1023.0;

float samplePoly6(float distSq, float h)
{
    float h2 = h * h;
    if (distSq >= h2) return 0.0;
    float t = clamp(sqrt(distSq) / h, 0.0, 1.0);
    float f = t * LUT_LAST;
    int i0 = int(floor(f));
    int i1 = min(i0 + 1, 1023);
    float a = f - float(i0);
    return mix(kernelLut[i0].x, kernelLut[i1].x, a);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) return;

    float h    = pc.effectLength;
    vec3  pi   = positions[i].xyz;
    float mass = positions[i].w;

    float density = samplePoly6(0.0, h) * mass;

    ivec3 dim   = ivec3(pc.gDimX, pc.gDimY, pc.gDimZ);
    vec3  orig  = vec3(pc.gOrigX, pc.gOrigY, pc.gOrigZ);
    ivec3 cellI = ivec3(floor((pi - orig) / pc.cellSize));

    for (int dz = -1; dz <= 1; ++dz)
    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx)
    {
        ivec3 cellJ = cellI + ivec3(dx, dy, dz);
        if (any(lessThan(cellJ, ivec3(0))) ||
            any(greaterThanEqual(cellJ, dim))) continue;

        int cellIdx = cellJ.x + cellJ.y * dim.x + cellJ.z * dim.x * dim.y;
        int start = cellStart[cellIdx];
        int cnt   = cellCount[cellIdx];

        for (int k = 0; k < cnt; ++k) {
            int j = sortedIdx[start + k];
            if (j == int(i)) continue;
            vec3  rij    = pi - positions[j].xyz;
            float distSq = dot(rij, rij);
            density += samplePoly6(distSq, h) * positions[j].w;
        }
    }

    velocities[i].w = density;
}
