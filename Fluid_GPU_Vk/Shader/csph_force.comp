#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer ParticlePos   { vec4 positions[];  };
layout(set = 0, binding = 1, std430) buffer ParticleVel   { vec4 velocities[]; };
layout(set = 0, binding = 2, std430) buffer ParticleForce { vec4 forces[];     };
layout(set = 0, binding = 3, std430) buffer CellCount     { int  cellCount[];  };
layout(set = 0, binding = 4, std430) buffer CellStart     { int  cellStart[];  };
layout(set = 0, binding = 5, std430) buffer SortedIdx     { int  sortedIdx[];  };
layout(set = 0, binding = 6, std430) readonly buffer KernelLut { vec4 kernelLut[]; };

layout(push_constant) uniform PC {
    uint  numParticles;
    float effectLength;
    float restDensity;
    float pressureCoe;
    float viscosityCoe;
    float cellSize;
    int   gDimX;
    int   gDimY;
    int   gDimZ;
    float gOrigX;
    float gOrigY;
    float gOrigZ;
} pc;

const float PI = 3.14159265358979323846;
const float LUT_LAST = 1023.0;

float sampleSpikyGradCoef(float dist, float h)
{
    if (dist >= h || dist < 1e-6) return 0.0;
    float t = clamp(dist / h, 0.0, 1.0);
    float f = t * LUT_LAST;
    int i0 = int(floor(f));
    int i1 = min(i0 + 1, 1023);
    float a = f - float(i0);
    return mix(kernelLut[i0].y, kernelLut[i1].y, a);
}

float sampleViscLaplacian(float dist, float h)
{
    if (dist >= h) return 0.0;
    float t = clamp(dist / h, 0.0, 1.0);
    float f = t * LUT_LAST;
    int i0 = int(floor(f));
    int i1 = min(i0 + 1, 1023);
    float a = f - float(i0);
    return mix(kernelLut[i0].z, kernelLut[i1].z, a);
}

float getPressure(float density)
{
    return pc.pressureCoe * max(0.0, density - pc.restDensity);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numParticles) return;

    float h     = pc.effectLength;
    vec3  pi    = positions[i].xyz;
    vec3  vi    = velocities[i].xyz;
    float rho_i = velocities[i].w;
    float p_i   = getPressure(rho_i);

    vec3 force = vec3(0.0);

    ivec3 dim   = ivec3(pc.gDimX, pc.gDimY, pc.gDimZ);
    vec3  orig  = vec3(pc.gOrigX, pc.gOrigY, pc.gOrigZ);
    ivec3 cellI = ivec3(floor((pi - orig) / pc.cellSize));

    for (int dz = -1; dz <= 1; ++dz)
    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx)
    {
        ivec3 cellJ = cellI + ivec3(dx, dy, dz);
        if (any(lessThan(cellJ, ivec3(0))) ||
            any(greaterThanEqual(cellJ, dim))) continue;

        int cellIdx = cellJ.x + cellJ.y * dim.x + cellJ.z * dim.x * dim.y;
        int start = cellStart[cellIdx];
        int cnt   = cellCount[cellIdx];

        for (int k = 0; k < cnt; ++k) {
            int  j      = sortedIdx[start + k];
            if (j == int(i)) continue;

            vec3  pj    = positions[j].xyz;
            vec3  vj    = velocities[j].xyz;
            float rho_j = velocities[j].w;
            float mj    = positions[j].w;
            float p_j   = getPressure(rho_j);

            vec3  rij  = pi - pj;
            float dist = length(rij);

            float spikyCoef = sampleSpikyGradCoef(dist, h);
            force += (rij * spikyCoef) * ((p_i + p_j) * 0.5 * mj);
            force += pc.viscosityCoe * (vj - vi) * sampleViscLaplacian(dist, h) * mj;
        }
    }

    forces[i] = vec4(force, 0.0);
}
