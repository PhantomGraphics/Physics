#version 450
#extension GL_GOOGLE_include_directive : require

// PBVR particle generation for the Flame page (plan Phase 4).
//
// One invocation per (absorbing source i, ensemble e). Each source is a smoke
// puff: a uniform sphere of world diameter S whose optical depth through the
// centre is tau0 = sigma * density (the same Beer-Lambert sphere Normal mode
// draws with flame_smoke.frag). It is replaced by N ~ Poisson(lambda) opaque
// sub-particles of diameter s = S / k placed uniformly inside the sphere.
//
// Particle density from opacity (Sakamoto et al., PBVR): a ray whose chord
// through the sphere is L crosses n * L * (pi s^2 / 4) sub-particle discs on
// average, so matching exp(-tau0 * L / S) needs n * pi s^2 / 4 = tau0 / S,
// i.e. lambda = n * (pi S^3 / 6) = (2/3) * tau0 * k^2 -- the PBVR relation
// rho = -ln(1 - alpha) / (pi r^2 dt) written for this geometry.
//
// k is clamped so a sub-particle never projects below ubo.view.z pixels: the
// density cap of Sakamoto's "one particle per pixel footprint" argument
// (PLAN_pbvr_gps_ensemble_lod.md Phase 0), which otherwise lets lambda grow as
// k^2 while the extra particles add nothing but cost.
layout(local_size_x = 64) in;

#include "flame_common.glsl"

struct Source {
    vec4 posSize; // xyz = world position, w = world diameter
    vec4 attr;    // x = soot optical density, y = temperature
};
layout(std430, set = 0, binding = 1) readonly buffer Sources { Source src[]; };
layout(std430, set = 0, binding = 2) writeonly buffer OutPos { vec4 outPos[]; };   // xyz, w = diameter
layout(std430, set = 0, binding = 3) writeonly buffer OutColor { vec4 outCol[]; };
layout(std430, set = 0, binding = 4) buffer Counters { uint counts[]; };           // one per ensemble

layout(push_constant) uniform PC {
    uint sourceCount;
    uint ensembleCount;
    uint seedBase;
    uint capacity;     // vertices per ensemble segment
    uint maxPerSource;
} pc;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

uint rngState;
float rand01() {
    rngState = pcg(rngState);
    return float(rngState) * (1.0 / 4294967296.0);
}

uint samplePoisson(float lambda) {
    if (lambda <= 0.0) {
        return 0u;
    }
    if (lambda < 12.0) {
        // Knuth: multiply uniforms until the product drops below e^-lambda.
        float limit = exp(-lambda);
        float p = rand01();
        uint n = 0u;
        while (p > limit && n < 64u) {
            p *= rand01();
            n++;
        }
        return n;
    }
    // Normal approximation (Box-Muller) for large means.
    float u1 = max(rand01(), 1.0e-7);
    float u2 = rand01();
    float z = sqrt(-2.0 * log(u1)) * cos(6.2831853 * u2);
    return uint(max(0.0, floor(lambda + sqrt(lambda) * z + 0.5)));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint e = gl_GlobalInvocationID.y;
    if (i >= pc.sourceCount || e >= pc.ensembleCount) {
        return;
    }
    Source s = src[i];
    float S = s.posSize.w;
    float tau0 = ubo.smoke.x * s.attr.x;
    if (S <= 0.0 || tau0 <= 0.0) {
        return;
    }
    vec4 clip = ubo.mvp * vec4(s.posSize.xyz, 1.0);
    if (clip.w <= 1.0e-3) {
        return; // behind the camera
    }
    float sizePx = flameProjectedSize(S, clip);
    float k = clamp(min(ubo.smoke.z, sizePx / max(ubo.view.z, 0.5)), 1.0, 8.0);
    float lambda = (2.0 / 3.0) * tau0 * k * k * ubo.view.w;

    rngState = pcg(i ^ pcg(pc.seedBase + e * 0x9E3779B9u));
    uint n = min(samplePoisson(lambda), pc.maxPerSource);
    if (n == 0u) {
        return;
    }

    vec4 color = vec4(smokeColor(s.attr.y), 1.0);
    float sub = S / k;
    float radius = 0.5 * S;
    uint base = e * pc.capacity;
    for (uint j = 0u; j < n; ++j) {
        // Uniform in the sphere: cube-root radius, uniform direction.
        float r = radius * pow(rand01(), 1.0 / 3.0);
        float cz = 2.0 * rand01() - 1.0;
        float phi = 6.2831853 * rand01();
        float sz = sqrt(max(0.0, 1.0 - cz * cz));
        vec3 p = s.posSize.xyz + r * vec3(sz * cos(phi), sz * sin(phi), cz);

        uint idx = atomicAdd(counts[e], 1u);
        if (idx < pc.capacity) {
            outPos[base + idx] = vec4(p, sub);
            outCol[base + idx] = color;
        }
    }
}
