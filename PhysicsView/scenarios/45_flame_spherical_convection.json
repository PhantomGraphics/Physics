{
  "name": "45_flame_spherical_convection",
  "_comment": "Fixed carriers in a cold-wall sphere. Compare local heating with and without buoyancy; no emitter, curl noise or confinement. Uses a small sphere for routine regression.",
  "steps": [
    { "command": "SetFlamePage:true", "expect": "OK" },
    { "command": "FlameSpherePreset:convection,0.3,0.06", "expect": "OK" },
    { "command": "GetFlameParam:fixedCarriers", "expect_range": "1,1" },
    { "command": "GetFlameStat:count", "store_as": "initial_count", "expect_range": "100,1000" },
    { "command": "GetFlameStat:allAvgT", "expect_range": "299.99,300.01" },
    { "command": "SetFlameParam:buoyancyCoe,0", "expect": "OK" },
    { "command": "SetFlameParam:sourcePower,4", "expect": "OK" },
    { "command": "FlameStep:180", "expect": "OK" },
    { "command": "GetFlameStat:kineticEnergy", "store_as": "without_buoyancy", "expect_range": "0,1" },
    { "command": "FlameSpherePreset:convection,0.3,0.06", "expect": "OK" },
    { "command": "SetFlameParam:sourcePower,4", "expect": "OK" },
    { "command": "FlameStep:180", "expect": "OK" },
    { "command": "GetFlameStats", "expect_prefix": "count=" },
    { "command": "GetFlameStat:kineticEnergy", "store_as": "with_buoyancy", "expect_range": "0.000001,1" },
    { "command": "GetFlameStat:allAvgT", "expect_range": "301,1000" },
    { "command": "GetFlameStat:count", "expect": "${initial_count}" },
    { "command": "GetFlameStat:nanCount", "expect_range": "0,0" },
    { "command": "GetFlameStat:maxWallPenetration", "expect_range": "0,0.000001" },
    { "command": "GetFlameStat:heatBalanceError", "expect_range": "-0.001,0.001" },
    { "command": "GetFlameSecondaryCount", "expect": "Count:0" },
    { "command": "SetFlameRenderParam:carrierDebug,2", "expect": "OK" },
    { "command": "GetFlameRenderParam:carrierDebug", "expect_range": "2,2" },
    { "command": "StopFlameSource", "expect": "OK" },
    { "command": "GetFlameParam:sourcePower", "expect_range": "0,0" },
    { "command": "FlameSpherePreset:convection,-1,0.06", "expect_prefix": "Error:" },
    { "command": "SetFlameParam:wallRate,-1", "expect_prefix": "Error:" },
    { "command": "SetFlameParam:density,2", "expect_prefix": "Error:" }
  ],
  "post_assert": "with_buoyancy > without_buoyancy"
}
