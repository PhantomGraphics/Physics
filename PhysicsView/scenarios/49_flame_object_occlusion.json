{
  "name": "49_flame_object_occlusion",
  "tags": ["flame-object"],
  "steps": [
    { "command": "FlameCombustionPreset", "expect": "OK" },
    { "command": "GetFlameBodyStat:1,pyrolyzed", "expect_range": "0,0" },
    { "command": "AddFlameBody:box,0,0.29,0,0.5,0.005,0.5,0.001,3", "expect_prefix": "Id:" },
    { "command": "FlameStep:60", "expect": "OK" },
    { "command": "StopFlameSource", "expect": "OK" },
    { "command": "FlameStep:360", "expect": "OK" },
    { "command": "GetFlameBodyStat:0,pyrolyzed", "expect_range": "0.0001,0.006" },
    { "command": "GetFlameBodyStat:1,pyrolyzed", "expect_range": "0,0" },
    { "command": "GetFlameBodyStat:1,firstIgnitionTime", "expect_range": "-1,-1" },
    { "command": "GetFlameBodyStat:3,pyrolyzed", "expect_range": "0,0" },
    { "command": "GetFlameStat:fuelBalanceError", "expect_range": "-0.0000002,0.0000002" },
    { "command": "GetFlameStat:nanCount", "expect_range": "0,0" }
  ]
}
