{
  "name": "07_smoke_hair_styles",
  "tags": ["hair"],
  "steps": [
    { "command": "GetHairStat:particles", "expect": "0", "label": "Precondition: empty scene" },
    { "command": "GetHairStat:followers", "expect": "0" },
    { "command": "HairPreset:StrongWind", "expect": "OK" },
    { "command": "SetHairMotion:true", "expect": "OK" },
    { "command": "HairPreset:ShortFur", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "96" },
    { "command": "GetHairStat:particles", "expect": "384" },
    { "command": "GetHairStat:followers", "expect": "768" },
    { "command": "GetHairStat:followerVertices", "expect": "3072" },
    { "command": "GetHairStat:colliders", "expect": "0" },
    { "command": "IsHairMotion", "expect": "false" },
    { "command": "GetHairParam:windX", "expect": "0" },
    { "command": "GetHairStat:tipY", "store_as": "fur_rest" },
    { "command": "GetHairStat:followerTipY", "store_as": "fur_follower_rest" },
    { "command": "SetHairParam:windX,2", "expect": "OK" },
    { "command": "SetHairParam:windDrag,1", "expect": "OK" },
    { "command": "HairStep:60", "expect": "OK" },
    { "command": "GetHairStat:time", "expect_range": "0.9999,1.0001", "label": "Change: fixed clock advances" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "GetHairStat:tipY", "expect": "${fur_rest}" },
    { "command": "GetHairStat:followerTipY", "expect": "${fur_follower_rest}" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "48" },
    { "command": "GetHairStat:particles", "expect": "1152" },
    { "command": "GetHairStat:followers", "expect": "384" },
    { "command": "GetHairStat:followerVertices", "expect": "9216" },
    { "command": "GetHairParam:windDrag", "expect": "0" },
    { "command": "GetHairParam:iterations", "expect": "8" },
    { "command": "GetHairStat:steps", "expect": "0" },
    { "command": "IsHairRunning", "expect": "false" },
    { "command": "GetHairStat:followerTipX", "store_as": "long_follower_x" },
    { "command": "HairTeleport:1,0,0,1,0,0,0", "expect": "OK" },
    { "command": "GetHairStat:followerTipX", "expect_range": "0.5,1.5", "store_as": "long_follower_teleported", "label": "Follower geometry follows teleport immediately" },
    { "command": "HairTeleport:0,0,0,1,0,0,0", "expect": "OK" },
    { "command": "HairStep:60", "expect": "OK" },
    { "command": "GetHairStat:steps", "expect": "60" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "NewScene", "expect": "OK" },
    { "command": "GetHairStat:particles", "expect": "0" },
    { "command": "GetHairStat:followers", "expect": "0" },
    { "command": "GetHairStat:followerVertices", "expect": "0" }
  ],
  "post_assert": "long_follower_teleported > long_follower_x"
}
