{
  "name": "49_flame_physical_combustion",
  "_comment": "Cold fuel supply does not ignite Physical chemistry. A pilot then ignites the same fixed carrier population.",
  "steps": [
    {
      "command": "SetFlamePage:true",
      "expect": "OK"
    },
    {
      "command": "SetFlameRunning:false",
      "expect": "OK"
    },
    {
      "command": "FlameReset",
      "expect": "OK"
    },
    {
      "command": "GetFlameParam:fixedCarriers",
      "expect_range": "1,1"
    },
    {
      "command": "GetFlameStat:count",
      "store_as": "carriers"
    },
    {
      "command": "SetFlameParam:emitterPilotTemperature,0",
      "expect": "OK"
    },
    {
      "command": "SetFlameParam:emitterFuelTemperature,300",
      "expect": "OK"
    },
    {
      "command": "FlameStep:60",
      "expect": "OK"
    },
    {
      "command": "GetFlameStat:sourceFuel",
      "expect_range": "0.000001,1"
    },
    {
      "command": "GetFlameStat:burnedFuel",
      "expect_range": "0,0"
    },
    {
      "command": "GetFlameStat:maxT",
      "expect_range": "299.9,300.1"
    },
    {
      "command": "SetFlameParam:emitterPilotTemperature,1500",
      "expect": "OK"
    },
    {
      "command": "FlameStep:120",
      "expect": "OK"
    },
    {
      "command": "GetFlameStats",
      "expect_prefix": "count="
    },
    {
      "command": "GetFlameStat:burnedFuel",
      "expect_range": "0.000001,1"
    },
    {
      "command": "GetFlameStat:maxT",
      "expect_range": "1000,2600"
    },
    {
      "command": "GetFlameStat:count",
      "expect": "${carriers}"
    },
    {
      "command": "GetFlameStat:fuelBalanceError",
      "expect_range": "-0.00001,0.00001"
    },
    {
      "command": "GetFlameStat:oxygenBalanceError",
      "expect_range": "-0.00001,0.00001"
    },
    {
      "command": "GetFlameStat:nanCount",
      "expect_range": "0,0"
    },
    {
      "command": "SetFlamePage:false",
      "expect": "OK"
    }
  ]
}
