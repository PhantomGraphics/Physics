{
  "name": "45_flame_default_stats",
  "_comment": "Prefilled fixed-carrier sphere: continuous fuel/heat supply, outer cooling and recovery. Check ignition at four seconds and bounded recycling through twenty simulated seconds.",
  "steps": [
    { "label": "Liveness check", "command": "GetStatus", "expect": "OK" },
    { "label": "Show the Flame page", "command": "SetFlamePage:true", "expect": "OK" },
    { "label": "Precondition: page switched", "command": "IsFlamePage", "expect": "true" },
    { "label": "Keep the sim paused (FlameStep drives it)", "command": "SetFlameRunning:false", "expect": "OK" },
    { "label": "Rebuild the default scene", "command": "FlameReset", "expect": "OK" },
    { "label": "Precondition: permanent air lattice", "command": "GetFlameStat:count", "store_as": "carrier_count", "expect_range": "100,4000" },
    { "label": "Precondition: sim clock reset", "command": "GetFlameSimTime", "expect_range": "0,0" },

    { "label": "Run 4 simulated seconds", "command": "FlameStep:240", "expect": "OK" },
    { "label": "Stats summary (logged for the baseline)", "command": "GetFlameStats", "expect_prefix": "count=" },
    { "label": "Sim clock advanced by 240 * 1/60", "command": "GetFlameSimTime", "expect_range": "3.99,4.01" },
    { "label": "Invariant: source reuses the same carriers", "command": "GetFlameStat:count", "expect": "${carrier_count}" },
    { "label": "Permanent ambient carriers remain", "command": "GetFlameStat:airCount", "expect_range": "100,4000" },
    { "label": "Change: the plume rose off the emitter", "command": "GetFlameStat:avgY", "expect_range": "0.3,4.0" },
    { "label": "Change: cosmetic smoke spawned", "command": "GetFlameStat:secondaryCount", "expect_range": "1,4000" },
    { "label": "Change: soot produced", "command": "GetFlameStat:avgSoot", "expect_range": "0.000001,10" },
    { "label": "Invariant: no NaN/inf particle", "command": "GetFlameStat:nanCount", "expect_range": "0,0" },
    { "label": "Invariant: stays inside the sphere", "command": "GetFlameStat:maxWallPenetration", "expect_range": "0,0.00001" },
    { "label": "Invariant: temperatures bounded", "command": "GetFlameStat:maxT", "expect_range": "300,3000" },
    { "label": "Invariant: speeds bounded", "command": "GetFlameStat:maxSpeed", "expect_range": "0,3.00001" },
    { "label": "Carrier mass before extended circulation", "command": "GetFlameStat:carrierMass", "store_as": "carrier_mass" },
    { "label": "Extend continuous circulation to twenty seconds", "command": "FlameStep:960", "expect": "OK" },
    { "label": "Invariant: no carrier creation/deletion in the long tail", "command": "GetFlameStat:count", "expect": "${carrier_count}" },
    { "label": "Invariant: carrier mass retained", "command": "GetFlameStat:carrierMass", "expect": "${carrier_mass}" },
    { "label": "Invariant: no NaN in the long tail", "command": "GetFlameStat:nanCount", "expect_range": "0,0" },
    { "label": "Invariant: bounded long-tail temperature", "command": "GetFlameStat:maxT", "expect_range": "300,2600" },
    { "label": "Invariant: bounded long-tail speed", "command": "GetFlameStat:maxSpeed", "expect_range": "0,3.00001" },
    { "label": "Invariant: long-tail wall containment", "command": "GetFlameStat:maxWallPenetration", "expect_range": "0,0.00001" },
    { "label": "Invariant: fuel sources and reaction close the budget", "command": "GetFlameStat:fuelBalanceError", "expect_range": "-0.00001,0.00001" },
    { "label": "Extended-circulation diagnostics", "command": "GetFlameStats", "expect_prefix": "count=" }
  ]
}
