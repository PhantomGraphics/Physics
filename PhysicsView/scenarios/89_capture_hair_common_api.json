{
  "name": "89_capture_hair_common_api",
  "tags": ["hair", "demo"],
  "_comment": "CPU shared-API demo: synthetic scalp long hair, then capsule fur. Both use the same wind, root motion, step, reset and teleport commands. Re-running explicitly restores generation settings.",
  "steps": [
    { "command": "HairClear", "expect": "OK" },
    { "command": "SetHairPage:true", "expect": "OK" },
    { "command": "SetHairGenerationParam:seed,2026", "expect": "OK" },
    { "command": "SetHairGenerationParam:rootJitter,0.5", "expect": "OK" },
    { "command": "SetHairGenerationParam:shapeVariation,0.02", "expect": "OK" },
    { "command": "SetHairGenerationParam:lengthVariation,0.05", "expect": "OK" },
    { "command": "SetHairGenerationParam:longHairGuides,32", "expect": "OK" },
    { "command": "SetHairGenerationParam:longHairFollowers,512", "expect": "OK" },
    { "command": "SetHairGenerationParam:shortFurGuides,64", "expect": "OK" },
    { "command": "SetHairGenerationParam:shortFurFollowers,1024", "expect": "OK" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "32" },
    { "command": "GetHairStat:particles", "expect": "768" },
    { "command": "GetHairStat:followers", "expect": "512" },
    { "command": "GetHairStat:followerVertices", "expect": "12288" },
    { "command": "GetHairStat:steps", "expect": "0" },
    { "command": "GetHairStat:tipX", "store_as": "longRestTip" },
    { "command": "GetHairStat:followerTipX", "store_as": "longRestFollower" },
    { "command": "SetCameraTarget:0,0.9,0", "expect": "OK" },
    { "command": "SetCameraOrbit:3,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "SaveScreenshot:testdata/screenshots/89_hair_demo_long_rest.png", "expect": "OK" },
    { "command": "SetHairParam:windX,2", "expect": "OK" },
    { "command": "SetHairParam:windDrag,1", "expect": "OK" },
    { "command": "SetHairMotion:true", "expect": "OK" },
    { "command": "HairStep:30", "expect": "OK" },
    { "command": "GetHairStat:tipX", "expect_not": "${longRestTip}" },
    { "command": "GetHairStat:followerTipX", "expect_not": "${longRestFollower}" },
    { "command": "GetHairStat:steps", "expect": "30" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "SaveScreenshot:testdata/screenshots/89_hair_demo_long_motion.png", "expect": "OK" },
    { "command": "SetHairMotion:false", "expect": "OK" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "GetHairStat:tipX", "expect": "${longRestTip}" },
    { "command": "GetHairStat:followerTipX", "expect": "${longRestFollower}" },
    { "command": "HairTeleport:0.3,0,0,1,0,0,0", "expect": "OK" },
    { "command": "GetHairStat:maxSpeed", "expect": "0" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "HairPreset:ShortFur", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "64" },
    { "command": "GetHairStat:particles", "expect": "256" },
    { "command": "GetHairStat:followers", "expect": "1024" },
    { "command": "GetHairStat:followerVertices", "expect": "4096" },
    { "command": "GetHairStat:steps", "expect": "0" },
    { "command": "GetHairParam:windX", "expect": "0" },
    { "command": "IsHairMotion", "expect": "false" },
    { "command": "GetHairStat:tipX", "store_as": "furRestTip" },
    { "command": "GetHairStat:followerTipX", "store_as": "furRestFollower" },
    { "command": "SetCameraTarget:0,1.05,0", "expect": "OK" },
    { "command": "SetCameraOrbit:2,1.1,0.25", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "SaveScreenshot:testdata/screenshots/89_hair_demo_fur_rest.png", "expect": "OK" },
    { "command": "SetHairParam:windX,2", "expect": "OK" },
    { "command": "SetHairParam:windDrag,1", "expect": "OK" },
    { "command": "SetHairMotion:true", "expect": "OK" },
    { "command": "HairStep:30", "expect": "OK" },
    { "command": "GetHairStat:tipX", "expect_not": "${furRestTip}" },
    { "command": "GetHairStat:followerTipX", "expect_not": "${furRestFollower}" },
    { "command": "GetHairStat:steps", "expect": "30" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "SaveScreenshot:testdata/screenshots/89_hair_demo_fur_motion.png", "expect": "OK" },
    { "command": "SetHairMotion:false", "expect": "OK" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "GetHairStat:tipX", "expect": "${furRestTip}" },
    { "command": "GetHairStat:followerTipX", "expect": "${furRestFollower}" },
    { "command": "HairTeleport:0.3,0,0,1,0,0,0", "expect": "OK" },
    { "command": "GetHairStat:maxSpeed", "expect": "0" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "HairTeleport:0,0,0,1,0,0,0", "expect": "OK" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "IsHairRunning", "expect": "false" }
  ]
}
