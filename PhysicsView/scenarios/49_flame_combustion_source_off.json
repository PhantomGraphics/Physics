{
  "name": "49_flame_combustion_source_off",
  "_comment": "Source off keeps gas carriers and the solid fuel budget finite. Moved from PhysicsTest SolidCombustionTest (each took tens of seconds in Release).",
  "tags": [
    "flame-object",
    "debug-slow"
  ],
  "steps": [
    {
      "command": "SetFlamePage:true",
      "expect": "OK"
    },
    {
      "command": "SetFlameRunning:false",
      "expect": "OK"
    },
    {
      "command": "FlameCombustionPreset",
      "expect": "OK"
    },
    {
      "command": "GetFlameBodyStat:0,pyrolyzed",
      "expect_range": "0,0"
    },
    {
      "command": "GetFlameBodyStat:1,pyrolyzed",
      "expect_range": "0,0"
    },
    {
      "command": "GetFlameStat:count",
      "store_as": "count"
    },
    {
      "command": "FlameStep:60",
      "expect": "OK"
    },
    {
      "command": "GetFlameBodyStat:0,pyrolyzed",
      "expect_range": "0.000001,1"
    },
    {
      "command": "GetFlameBodyStat:1,pyrolyzed",
      "expect_range": "0,0"
    },
    {
      "command": "StopFlameSource",
      "expect": "OK"
    },
    {
      "command": "GetFlameStat:sourceFuel",
      "store_as": "sourceAtStop"
    },
    {
      "command": "FlameStep:180",
      "expect": "OK"
    },
    {
      "command": "GetFlameStat:count",
      "expect": "${count}"
    },
    {
      "command": "GetFlameStat:sourceFuel",
      "expect": "${sourceAtStop}"
    },
    {
      "command": "GetFlameStat:fuelBalanceError",
      "expect_range": "-2e-7,2e-7"
    },
    {
      "command": "GetFlameStat:nanCount",
      "expect_range": "0,0"
    },
    {
      "command": "GetFlameBodyStat:0,firstIgnitionTime",
      "expect_range": "0.000001,100"
    },
    {
      "command": "GetFlameBodyStat:0,residue",
      "expect_range": "0.000001,1"
    },
    {
      "command": "GetFlameBodyStat:2,pyrolyzed",
      "expect_range": "0,0"
    },
    {
      "command": "SetFlameParam:timeStep,0.0166667",
      "expect": "OK"
    },
    {
      "command": "SetFlamePage:false",
      "expect": "OK"
    }
  ]
}