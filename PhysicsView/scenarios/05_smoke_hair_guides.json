{
  "name": "05_smoke_hair_guides",
  "tags": ["hair"],
  "steps": [
    { "command": "GetHairStat:particles", "expect": "0", "label": "Precondition: empty scene" },
    { "command": "SetHairPage:true", "expect": "OK" },
    { "command": "IsHairPage", "expect": "true" },
    { "command": "HairPreset:Single", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "1" },
    { "command": "GetHairStat:particles", "expect": "24" },
    { "command": "GetHairStat:tipY", "store_as": "initial_tip" },
    { "command": "HairStep:120", "expect": "OK" },
    { "command": "GetHairStat:time", "expect_range": "1.9999,2.0001" },
    { "command": "GetHairStat:tipY", "expect_range": "-1,0.34", "label": "Change: tip falls below its initial height" },
    { "command": "GetHairStat:rootError", "expect": "0", "label": "Invariant: fixed root" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01", "label": "Invariant: less than 1 percent stretch" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "GetHairStat:time", "expect": "0" },
    { "command": "GetHairStat:maxSpeed", "expect": "0" },
    { "command": "GetHairStat:tipY", "expect": "${initial_tip}", "label": "Reset restores initial curve" },
    { "command": "HairPreset:Bundle", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "48" },
    { "command": "GetHairStat:particles", "expect": "1152" },
    { "command": "SetHairRunning:true", "expect": "OK" },
    { "command": "IsHairRunning", "expect": "true" },
    { "command": "SetHairRunning:false", "expect": "OK" },
    { "command": "IsHairRunning", "expect": "false" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "SetHairParam:substeps,8", "expect": "OK" },
    { "command": "GetHairParam:substeps", "expect": "8" },
    { "command": "HairStep:60", "expect": "OK" },
    { "command": "GetHairStat:steps", "expect": "60" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "SetHairParam:iterations,0", "expect_prefix": "Error:" },
    { "command": "SetHairParam:substeps,1.5", "expect_prefix": "Error:" },
    { "command": "SetHairParam:shapeCompliance,nan", "expect_prefix": "Error:" },
    { "command": "HairStep:0", "expect_prefix": "Error:" },
    { "command": "HairPreset:Unknown", "expect_prefix": "Error:" },
    { "command": "HairClear", "expect": "OK" },
    { "command": "GetHairStat:particles", "expect": "0" },
    { "command": "HairPreset:Bundle", "expect": "OK" },
    { "command": "NewScene", "expect": "OK" },
    { "command": "GetHairStat:particles", "expect": "0", "label": "NewScene removes hair" },
    { "command": "GetHairStat:time", "expect": "0" },
    { "command": "SetHairPage:false", "expect": "OK" },
    { "command": "IsHairPage", "expect": "false" },
    { "command": "GetStatus", "expect": "OK" }
  ]
}
