{
  "name": "49_flame_object_combustion",
  "_comment": "Finite volume solid-SPH fuel: source heats A for one second, then switches off. B cannot pyrolyze before source removal; inert-A unit-test control proves B is heated by A. Capture heating, spread and exhausted particle residue in Normal/PBVR.",
  "tags": ["flame-object"],
  "steps": [
    { "command": "SetFlamePage:true", "expect": "OK" },
    { "command": "SetFlameRunning:false", "expect": "OK" },
    { "command": "FlameCombustionPreset", "expect": "OK" },
    { "command": "GetFlameBodyCount", "expect_range": "3,3" },
    { "command": "GetFlameBodyStat:0,state", "expect_range": "0,0" },
    { "command": "GetFlameBodyStat:1,pyrolyzed", "expect_range": "0,0" },
    { "command": "SetFlameRenderParam:hazeEnabled,0", "expect": "OK" },
    { "command": "SetCameraTarget:0,4,0", "expect": "OK" },
    { "command": "SetCameraOrbit:18,1.1,1.35", "expect": "OK" },
    { "command": "SetUIVisible:false", "expect": "OK" },
    { "command": "FlameStep:30", "expect": "OK" },
    { "command": "SaveScreenshot:testdata/screenshots/49_object_heating_normal.png", "expect": "OK" },
    { "command": "SetFlameRenderMode:PBVR", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 32 },
    { "command": "SaveScreenshot:testdata/screenshots/49_object_heating_pbvr.png", "expect": "OK" },
    { "command": "FlameStep:30", "expect": "OK" },
    { "command": "GetFlameBodyStat:0,pyrolyzed", "expect_range": "0.0001,0.006" },
    { "command": "GetFlameBodyStat:1,pyrolyzed", "expect_range": "0,0" },
    { "command": "StopFlameSource", "expect": "OK" },
    { "command": "GetFlameParam:emitterRate", "expect_range": "0,0" },
    { "command": "GetFlameParam:emitterPilotTemperature", "expect_range": "0,0" },
    { "command": "FlameStep:60", "expect": "OK" },
    { "command": "GetFlameBodyStat:0,state", "expect_range": "2,2" },
    { "command": "GetFlameBodyStat:1,pyrolyzed", "expect_range": "0.00001,0.006" },
    { "command": "GetFlameBodyStat:1,firstIgnitionTime", "expect_range": "1.01,3" },
    { "command": "SetFlameRenderMode:Normal", "expect": "OK" },
    { "command": "SaveScreenshot:testdata/screenshots/49_object_spread_normal.png", "expect": "OK" },
    { "command": "SetFlameRenderMode:PBVR", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 32 },
    { "command": "SaveScreenshot:testdata/screenshots/49_object_spread_pbvr.png", "expect": "OK" },
    { "command": "FlameStep:600", "expect": "OK" },
    { "command": "GetFlameBodyStat:0,state", "expect_range": "4,4" },
    { "command": "GetFlameBodyStat:1,state", "expect_range": "4,4" },
    { "command": "GetFlameBodyStat:0,fuel", "expect_range": "0,0.0000001" },
    { "command": "GetFlameBodyStat:1,fuel", "expect_range": "0,0.0000001" },
    { "command": "GetFlameBodyStat:0,residue", "expect_range": "0.0008,0.001" },
    { "command": "GetFlameBodyStat:2,pyrolyzed", "expect_range": "0,0" },
    { "command": "GetFlameStat:gasFuel", "expect_range": "0,0.0000001" },
    { "command": "GetFlameStat:fuelBalanceError", "expect_range": "-0.0000002,0.0000002" },
    { "command": "GetFlameStat:nanCount", "expect_range": "0,0" },
    { "command": "GetFlameFuelBudget", "expect_prefix": "initial=" },
    { "command": "SetFlameRenderMode:Normal", "expect": "OK" },
    { "command": "SaveScreenshot:testdata/screenshots/49_object_burnout_normal.png", "expect": "OK" },
    { "command": "SetFlameRenderMode:PBVR", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 32 },
    { "command": "SaveScreenshot:testdata/screenshots/49_object_burnout_pbvr.png", "expect": "OK" },
    { "command": "SetUIVisible:true", "expect": "OK" }
  ]
}
