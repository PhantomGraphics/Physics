{
  "name": "49_flame_object_combustion",
  "_comment": "Finite solids in a prefilled sphere. Stop external fuel and retain carriers during cooling. Cooling may extinguish fuel before exhaustion; legacy spread times are not assumed.",
  "tags": [
    "flame-object",
    "debug-slow"
  ],
  "steps": [
    {
      "command": "SetFlamePage:true",
      "expect": "OK"
    },
    {
      "command": "SetFlameRunning:false",
      "expect": "OK"
    },
    {
      "command": "FlameCombustionPreset",
      "expect": "OK"
    },
    {
      "command": "GetFlameStat:count",
      "store_as": "carriers",
      "expect_range": "100,4000"
    },
    {
      "command": "GetFlameBodyCount",
      "expect_range": "3,3"
    },
    {
      "command": "GetFlameBodyStat:0,fuel",
      "store_as": "initial_fuel"
    },
    {
      "command": "SetFlameRenderParam:hazeEnabled,0",
      "expect": "OK"
    },
    {
      "command": "SetCameraTarget:0,4,0",
      "expect": "OK"
    },
    {
      "command": "SetCameraOrbit:18,1.1,1.35",
      "expect": "OK"
    },
    {
      "command": "SetUIVisible:false",
      "expect": "OK"
    },
    {
      "command": "FlameStep:60",
      "expect": "OK"
    },
    {
      "command": "GetFlameBodyStat:0,pyrolyzed",
      "expect_range": "0.000001,0.006"
    },
    {
      "command": "GetFlameStat:count",
      "expect": "${carriers}"
    },
    {
      "command": "SaveScreenshot:testdata/screenshots/49_object_heating_normal.png",
      "expect": "OK"
    },
    {
      "command": "SetFlameRenderMode:PBVR",
      "expect": "OK"
    },
    {
      "command": "GetStatus",
      "expect": "OK",
      "repeat": 16
    },
    {
      "command": "SaveScreenshot:testdata/screenshots/49_object_heating_pbvr.png",
      "expect": "OK"
    },
    {
      "command": "StopFlameSource",
      "expect": "OK"
    },
    {
      "command": "GetFlameStat:sourceFuel",
      "store_as": "source_stopped"
    },
    {
      "command": "GetFlameParam:emitterRate",
      "expect_range": "0,0"
    },
    {
      "command": "GetFlameParam:emitterPilotTemperature",
      "expect_range": "0,0"
    },
    {
      "command": "SetFlameRenderMode:Normal",
      "expect": "OK"
    },
    {
      "command": "SetFlameParam:lifeMax,0.01",
      "expect": "OK"
    },
    {
      "command": "FlameStep:180",
      "expect": "OK"
    },
    {
      "command": "GetFlameStat:count",
      "expect": "${carriers}"
    },
    {
      "command": "GetFlameStat:sourceFuel",
      "expect": "${source_stopped}"
    },
    {
      "command": "GetFlameBodyStat:0,fuel",
      "store_as": "remaining_fuel",
      "expect_range": "0,0.006"
    },
    {
      "command": "GetFlameBodyStat:2,pyrolyzed",
      "expect_range": "0,0"
    },
    {
      "command": "GetFlameStat:fuelBalanceError",
      "expect_range": "-0.0000002,0.0000002"
    },
    {
      "command": "GetFlameStat:nanCount",
      "expect_range": "0,0"
    },
    {
      "command": "GetFlameFuelBudget",
      "expect_prefix": "initial="
    },
    {
      "command": "GetFlameStat:maxWallPenetration",
      "expect_range": "0,0.00001"
    },
    {
      "command": "SaveScreenshot:testdata/screenshots/49_object_cooling_normal.png",
      "expect": "OK"
    },
    {
      "command": "SetFlameRenderMode:PBVR",
      "expect": "OK"
    },
    {
      "command": "GetStatus",
      "expect": "OK",
      "repeat": 16
    },
    {
      "command": "SaveScreenshot:testdata/screenshots/49_object_cooling_pbvr.png",
      "expect": "OK"
    },
    {
      "command": "SetUIVisible:true",
      "expect": "OK"
    }
  ],
  "post_assert": "remaining_fuel < initial_fuel"
}
