{
  "name": "08_smoke_hair_variation",
  "tags": ["hair"],
  "steps": [
    { "command": "SetHairPage:true", "expect": "OK" },
    { "command": "SetHairGenerationParam:seed,1234", "expect": "OK" },
    { "command": "GetHairGenerationParam:seed", "expect": "1234" },
    { "command": "SetHairGenerationParam:rootJitter,0.8", "expect": "OK" },
    { "command": "SetHairGenerationParam:shapeVariation,0.2", "expect": "OK" },
    { "command": "SetHairGenerationParam:lengthVariation,0.3", "expect": "OK" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:tipX", "store_as": "tip" },
    { "command": "GetHairStat:followerTipY", "store_as": "followerTip" },
    { "command": "HairStep:5", "expect": "OK" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "GetHairStat:tipX", "expect": "${tip}" },
    { "command": "GetHairStat:followerTipY", "expect": "${followerTip}" },
    { "command": "SetHairGenerationParam:lengthVariation,1", "expect_prefix": "Error:" },
    { "command": "SetHairGenerationParam:seed,1.5", "expect_prefix": "Error:" },
    { "command": "GetHairGenerationParam:seed", "expect": "1234" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:tipX", "expect": "${tip}" },
    { "command": "HairPreset:ShortFur", "expect": "OK" },
    { "command": "HairStep:5", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "96" },
    { "command": "GetHairStat:followers", "expect": "768" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" }
  ]
}
