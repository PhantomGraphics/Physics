{
  "name": "86_capture_hair_guides",
  "tags": ["hair"],
  "steps": [
    { "command": "GetHairStat:particles", "expect": "0", "label": "Precondition: empty scene" },
    { "command": "SetHairPage:true", "expect": "OK" },
    { "command": "HairPreset:Bundle", "expect": "OK" },
    { "command": "SetCameraTarget:0,0.9,0", "expect": "OK" },
    { "command": "SetCameraOrbit:5,0.25,0.1", "expect": "OK" },
    { "command": "HairStep:60", "expect": "OK", "label": "Change: simulate one second" },
    { "command": "GetHairStat:time", "expect_range": "0.9999,1.0001" },
    { "command": "GetHairStat:guides", "expect": "48" },
    { "command": "GetHairStat:rootError", "expect": "0", "label": "Invariant: roots remain pinned" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "SaveScreenshot:testdata/screenshots/86_capture_hair_guides.png", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK" }
  ]
}
