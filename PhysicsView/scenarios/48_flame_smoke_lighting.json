{
    "name":  "48_flame_smoke_lighting",
    "steps":  [
                  {
                      "expect":  "OK",
                      "command":  "GetStatus"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlamePage:true"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRunning:false"
                  },
                  {
                      "expect":  "OK",
                      "command":  "FlameReset"
                  },
                  {
                      "expect":  "OK",
                      "command":  "FlameStep:120"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetUIVisible:false"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetCameraOrbit:110,0,0.15"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetLight:-0.3,-1,-0.25,1,1,1,0"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:pbvrAdaptive,0"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:pbvrEnsembles,4"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:pbvrTargetEnsembles,256"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:smokeGlow,0"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:smokeAlbedo,0.3"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:smokeFlameLight,0"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderMode:PBVR"
                  },
                  {
                      "command":  "GetStatus",
                      "expect":  "OK",
                      "repeat":  72
                  },
                  {
                      "expect":  "OK",
                      "command":  "SaveScreenshot:testdata/screenshots/48_flame_light_off.png"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:smokeFlameLight,1"
                  },
                  {
                      "command":  "GetStatus",
                      "expect":  "OK",
                      "repeat":  72
                  },
                  {
                      "command":  "GetFlamePBVRStat:displayedEnsembles",
                      "expect_range":  "256,256"
                  },
                  {
                      "command":  "GetFlamePBVRStat:shadowGenerated",
                      "expect_range":  "1,1048576"
                  },
                  {
                      "command":  "GetFlamePBVRStat:shadowOverflowed",
                      "expect_range":  "0,0"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SaveScreenshot:testdata/screenshots/48_flame_light_on.png"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderParam:exposure,0"
                  },
                  {
                      "command":  "GetStatus",
                      "expect":  "OK",
                      "repeat":  72
                  },
                  {
                      "command":  "GetFlamePBVRStat:shadowGenerated",
                      "expect_range":  "0,0"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SaveScreenshot:testdata/screenshots/48_flame_light_no_emission.png"
                  },
                  {
                      "expect_prefix":  "Error:",
                      "command":  "SetFlameRenderParam:smokeFlameLight,-1"
                  },
                  {
                      "expect":  "OK",
                      "command":  "SetFlameRenderMode:Normal"
                  }
              ],
    "_comment":  "PBVR flame importance sampling with independent opaque smoke shadow ensembles; no voxel reconstruction."
}
