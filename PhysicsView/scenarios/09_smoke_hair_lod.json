{
  "name": "09_smoke_hair_lod",
  "tags": ["hair"],
  "steps": [
    { "command": "SetHairPage:true", "expect": "OK" },
    { "command": "SetHairLodParam:transitionSeconds,0", "expect": "OK" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairLodParam:enabled", "expect": "0" },
    { "command": "GetHairStat:particles", "expect": "1152" },
    { "command": "SetCameraTarget:0,1.05,0", "expect": "OK" },
    { "command": "SetCameraOrbit:3,0.25,0.1", "expect": "OK" },
    { "command": "SetHairLodParam:enabled,1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "GetHairLodStat:level", "expect": "0" },
    { "command": "GetHairLodStat:drawnFollowers", "expect": "384" },
    { "command": "HairStep:5", "expect": "OK" },
    { "command": "SetCameraOrbit:7,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "GetHairLodStat:level", "expect": "1" },
    { "command": "GetHairLodStat:updateScale", "expect": "2" },
    { "command": "GetHairLodStat:drawnFollowers", "expect": "192" },
    { "command": "GetHairStat:particles", "expect": "624" },
    { "command": "GetHairStat:steps", "expect": "5" },
    { "command": "SaveScreenshot:testdata/screenshots/09_hair_lod_medium.png", "expect": "OK" },
    { "command": "SetCameraOrbit:15,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "GetHairLodStat:level", "expect": "2" },
    { "command": "GetHairLodStat:distance", "expect_range": "14.9,15.1" },
    { "command": "GetHairLodStat:updateScale", "expect": "4" },
    { "command": "GetHairLodStat:drawnFollowers", "expect": "96" },
    { "command": "GetHairStat:particles", "expect": "336" },
    { "command": "HairStep:5", "expect": "OK" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "SaveScreenshot:testdata/screenshots/09_hair_lod_far.png", "expect": "OK" },
    { "command": "SetCameraOrbit:3,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "GetHairStat:particles", "expect": "1152" },
    { "command": "GetHairStat:steps", "expect": "10" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "HairPreset:ShortFur", "expect": "OK" },
    { "command": "SetCameraOrbit:15,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "GetHairStat:particles", "expect": "192" },
    { "command": "GetHairLodStat:drawnFollowers", "expect": "192" },
    { "command": "SetHairLodParam:farDistance,5", "expect_prefix": "Error:" },
    { "command": "SetHairLodParam:hysteresis,-1", "expect_prefix": "Error:" },
    { "command": "SetHairLodParam:enabled,0", "expect": "OK" },
    { "command": "GetHairStat:particles", "expect": "384" },
    { "command": "GetHairLodStat:drawnFollowers", "expect": "768" },
    { "command": "GetHairLodStat:level", "expect": "0" }
  ]
}
