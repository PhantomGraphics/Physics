{
  "name": "46_flame_params",
  "_comment": "Flame scenario command surface: SetFlameParam/GetFlameParam/SetFlameRenderParam round-trips, FlameReset semantics (sim params revert, time step and render params survive) and argument validation.",
  "steps": [
    { "label": "Liveness check", "command": "GetStatus", "expect": "OK" },
    { "label": "Show the Flame page", "command": "SetFlamePage:true", "expect": "OK" },
    { "label": "Keep paused", "command": "SetFlameRunning:false", "expect": "OK" },
    { "label": "Precondition: running flag off", "command": "IsFlameRunning", "expect": "false" },
    { "label": "Rebuild the default scene", "command": "FlameReset", "expect": "OK" },
    { "label": "Precondition: default burn rate", "command": "GetFlameParam:burnRate", "store_as": "burn_default" },
    { "label": "Precondition: default emitter rate", "command": "GetFlameParam:emitterRate", "expect_range": "149,151" },
    { "label": "Precondition: default time step 1/60", "command": "GetFlameParam:timeStep", "expect_range": "0.0166,0.0167" },

    { "label": "Set a sim parameter", "command": "SetFlameParam:burnRate,2.5", "expect": "OK" },
    { "label": "Change: round-trips", "command": "GetFlameParam:burnRate", "expect_range": "2.49,2.51" },
    { "label": "Set an emitter parameter", "command": "SetFlameParam:emitterRate,500", "expect": "OK" },
    { "label": "Change: emitter parameter round-trips", "command": "GetFlameParam:emitterRate", "expect_range": "499,501" },
    { "label": "Set the time step", "command": "SetFlameParam:timeStep,0.008333333", "expect": "OK" },
    { "label": "Set a render parameter", "command": "SetFlameRenderParam:particleSize,0.09", "expect": "OK" },
    { "label": "Change: render parameter round-trips", "command": "GetFlameRenderParam:particleSize", "expect_range": "0.0899,0.0901" },

    { "label": "FlameReset rebuilds the fluid", "command": "FlameReset", "expect": "OK" },
    { "label": "Invariant: sim parameter reverted to its default", "command": "GetFlameParam:burnRate", "store_as": "burn_after_reset" },
    { "label": "Invariant: emitter parameter reverted to its default", "command": "GetFlameParam:emitterRate", "expect_range": "149,151" },
    { "label": "Invariant: world time step survived the reset", "command": "GetFlameParam:timeStep", "expect_range": "0.00833,0.00834" },
    { "label": "Invariant: render parameter survived the reset", "command": "GetFlameRenderParam:particleSize", "expect_range": "0.0899,0.0901" },
    { "label": "Two half-size steps advance 1/60 s", "command": "FlameStep:2", "expect": "OK" },
    { "label": "Change: sim clock follows the time step", "command": "GetFlameSimTime", "expect_range": "0.0166,0.0167" },
    { "label": "Restore the default time step", "command": "SetFlameParam:timeStep,0.016666667", "expect": "OK" },
    { "label": "Restore the default particle size", "command": "SetFlameRenderParam:particleSize,0.16", "expect": "OK" },

    { "label": "Precondition: auto white balance by default", "command": "GetFlameRenderParam:whiteBalance", "expect_range": "1,1" },
    { "label": "Manual white balance", "command": "SetFlameRenderParam:whiteBalance,2", "expect": "OK" },
    { "label": "Manual white temperature", "command": "SetFlameRenderParam:whiteBalanceTemperature,2500", "expect": "OK" },
    { "label": "Change: white temperature round-trips", "command": "GetFlameRenderParam:whiteBalanceTemperature", "expect_range": "2499,2501" },
    { "label": "Restore auto white balance", "command": "SetFlameRenderParam:whiteBalance,1", "expect": "OK" },
    { "label": "Parameter names are listable", "command": "GetFlameParam:list", "expect_prefix": "density," },
    { "label": "Render parameter names are listable", "command": "GetFlameRenderParam:list", "expect_prefix": "particleSize," },
    { "label": "Negative: unknown parameter", "command": "SetFlameParam:bogus,1", "expect_prefix": "Error:" },
    { "label": "Negative: unknown render parameter", "command": "SetFlameRenderParam:bogus,1", "expect_prefix": "Error:" },
    { "label": "Negative: missing value", "command": "SetFlameParam:burnRate", "expect_prefix": "Error:" },
    { "label": "Negative: non-numeric value", "command": "SetFlameParam:burnRate,abc", "expect_prefix": "Error:" },
    { "label": "Negative: out-of-range value", "command": "SetFlameParam:burnRate,-1", "expect_prefix": "Error:" },
    { "label": "Negative: out-of-range time step", "command": "SetFlameParam:timeStep,0", "expect_prefix": "Error:" },
    { "label": "Negative: model enum must be 0/1", "command": "SetFlameParam:combustionModel,3", "expect_prefix": "Error:" },
    { "label": "Negative: unknown stat", "command": "GetFlameStat:bogus", "expect_prefix": "Error:" },
    { "label": "Negative: bad step count", "command": "FlameStep:x", "expect_prefix": "Error:" },
    { "label": "Negative: unknown render mode", "command": "SetFlameRenderMode:Fancy", "expect_prefix": "Error:" },
    { "label": "Invariant: a rejected set left the value alone", "command": "GetFlameParam:burnRate", "store_as": "burn_after_rejects" },
    { "label": "Stats are available on the page", "command": "GetFlameSecondaryCount", "expect_prefix": "Count:" },
    { "label": "Leave the Flame page", "command": "SetFlamePage:false", "expect": "OK" },
    { "label": "Invariant: back on the Fluid page", "command": "IsFlamePage", "expect": "false" }
  ],
  "post_assert": "burn_after_rejects == burn_default"
}
