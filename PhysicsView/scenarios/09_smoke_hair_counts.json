{
  "name": "09_smoke_hair_counts",
  "tags": ["hair"],
  "steps": [
    { "command": "SetHairPage:true", "expect": "OK" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "48" },
    { "command": "GetHairStat:followers", "expect": "384" },
    { "command": "SetHairGenerationParam:longHairGuides,7", "expect": "OK" },
    { "command": "SetHairGenerationParam:longHairFollowers,19", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "48" },
    { "command": "GetHairStat:followers", "expect": "384" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "7" },
    { "command": "GetHairStat:particles", "expect": "168" },
    { "command": "GetHairStat:followers", "expect": "19" },
    { "command": "GetHairStat:followerVertices", "expect": "456" },
    { "command": "HairStep:5", "expect": "OK" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:lengthError", "expect_range": "0,0.01" },
    { "command": "SetCameraTarget:0,0.9,0", "expect": "OK" },
    { "command": "SetCameraOrbit:5,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "SaveScreenshot:testdata/screenshots/09_hair_counts_long.png", "expect": "OK" },
    { "command": "SetHairGenerationParam:longHairFollowers,0", "expect": "OK" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:particles", "expect": "168" },
    { "command": "GetHairStat:followers", "expect": "0" },
    { "command": "SetHairGenerationParam:shortFurGuides,11", "expect": "OK" },
    { "command": "SetHairGenerationParam:shortFurFollowers,3", "expect": "OK" },
    { "command": "HairPreset:ShortFur", "expect": "OK" },
    { "command": "GetHairStat:particles", "expect": "44" },
    { "command": "GetHairStat:followers", "expect": "3" },
    { "command": "GetHairStat:followerVertices", "expect": "12" },
    { "command": "HairStep:5", "expect": "OK" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "SetCameraTarget:0,1.05,0", "expect": "OK" },
    { "command": "SetCameraOrbit:5,1.1,0.25", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "SaveScreenshot:testdata/screenshots/09_hair_counts_short.png", "expect": "OK" },
    { "command": "SetHairGenerationParam:shortFurGuides,0", "expect_prefix": "Error:" },
    { "command": "SetHairGenerationParam:shortFurFollowers,1.5", "expect_prefix": "Error:" },
    { "command": "SetHairGenerationParam:longHairFollowers,10001", "expect_prefix": "Error:" },
    { "command": "GetHairGenerationParam:shortFurGuides", "expect": "11" },
    { "command": "GetHairGenerationParam:shortFurFollowers", "expect": "3" },
    { "command": "HairClear", "expect": "OK" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "GetHairStat:guides", "expect": "7" },
    { "command": "GetHairStat:followers", "expect": "0" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "GetHairStat:steps", "expect": "0" }
  ]
}
