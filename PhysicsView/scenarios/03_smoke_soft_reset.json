{
  "name": "03_smoke_soft_reset",
  "steps": [
    { "label": "Default preset is ClothTwoPin", "command": "GetSoftBodyCount", "expect": "Count:1" },
    { "label": "Default particle count = 400 (20x20 cloth)", "command": "GetSoftParticleCount", "expect": "Particles:400" },
    { "label": "Cloth starts flat, resting on the always-on floor collider (y=0)", "command": "GetSoftMinPositionY", "expect": "0.000000" },
    { "label": "Flat sheet: max Y = min Y", "command": "GetSoftMaxPositionY", "expect": "0.000000" },
    { "label": "Reset returns OK", "command": "Reset", "expect": "OK" },
    { "label": "Body count unchanged after reset", "command": "GetSoftBodyCount", "expect": "Count:1" },
    { "label": "Particle count unchanged after reset", "command": "GetSoftParticleCount", "expect": "Particles:400" },
    { "label": "Min Y restored to the flat starting state", "command": "GetSoftMinPositionY", "expect": "0.000000" },
    { "label": "Max Y restored to the flat starting state", "command": "GetSoftMaxPositionY", "expect": "0.000000" }
  ]
}
