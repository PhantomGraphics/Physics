{
  "name": "09_smoke_hair_lod_transition",
  "tags": ["hair"],
  "steps": [
    { "command": "SetHairPage:true", "expect": "OK" },
    { "command": "SetHairLodParam:transitionSeconds,2", "expect": "OK" },
    { "command": "GetHairLodParam:transitionSeconds", "expect": "2" },
    { "command": "SetHairLodParam:transitionSeconds,3", "expect_prefix": "Error:" },
    { "command": "HairPreset:LongHair", "expect": "OK" },
    { "command": "SetCameraTarget:0,1.05,0", "expect": "OK" },
    { "command": "SetCameraOrbit:5,0.25,0.1", "expect": "OK" },
    { "command": "SetHairLodParam:enabled,1", "expect": "OK" },
    { "command": "SetHairParam:windX,2", "expect": "OK" },
    { "command": "SetHairParam:windDrag,1", "expect": "OK" },
    { "command": "HairStep:10", "expect": "OK" },
    { "command": "GetHairStat:steps", "expect": "10" },
    { "command": "SetCameraOrbit:15,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "GetHairLodStat:level", "expect": "2" },
    { "command": "GetHairLodStat:transitionProgress", "expect_range": "0,1" },
    { "command": "GetHairStat:steps", "expect": "10" },
    { "command": "SaveScreenshot:testdata/screenshots/09_hair_transition_out.png", "expect": "OK" },
    { "command": "HairStep:120", "expect": "OK" },
    { "command": "GetHairLodStat:transitionProgress", "expect": "1" },
    { "command": "GetHairStat:steps", "expect": "130" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "SetCameraOrbit:5,0.25,0.1", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "GetHairLodStat:level", "expect": "0" },
    { "command": "GetHairStat:steps", "expect": "130" },
    { "command": "SaveScreenshot:testdata/screenshots/09_hair_transition_in.png", "expect": "OK" },
    { "command": "HairStep:120", "expect": "OK" },
    { "command": "GetHairLodStat:transitionProgress", "expect": "1" },
    { "command": "GetHairStat:steps", "expect": "250" },
    { "command": "GetHairStat:rootError", "expect": "0" },
    { "command": "GetHairStat:nonFinite", "expect": "0" },
    { "command": "HairPreset:ShortFur", "expect": "OK" },
    { "command": "SetCameraOrbit:15,1.1,0.25", "expect": "OK" },
    { "command": "GetStatus", "expect": "OK", "repeat": 3 },
    { "command": "HairTeleport:1,0,0,1,0,0,0", "expect": "OK" },
    { "command": "GetHairLodStat:transitionProgress", "expect": "1" },
    { "command": "HairReset", "expect": "OK" },
    { "command": "GetHairStat:steps", "expect": "0" },
    { "command": "GetHairStat:maxSpeed", "expect": "0" }
  ]
}
